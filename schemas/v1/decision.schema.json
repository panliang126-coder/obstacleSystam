{
  "$id": "https://schemas.obstaclesystam.local/v1/decision.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-wire-schema": "decision/1.0",
  "title": "Decision Message v1.0",
  "allOf": [
    {"$ref": "common.schema.json#/$defs/envelope"},
    {
      "properties": {
        "schema": {"const": "decision/1.0"},
        "payload": {"$ref": "#/$defs/decision_payload"}
      }
    }
  ],
  "$defs": {
    "decision_payload": {
      "type": "object",
      "required": [
        "decision_id",
        "mission_id",
        "action",
        "priority",
        "path_id",
        "risk_id",
        "twin_revision",
        "reason_codes",
        "explanation",
        "preconditions",
        "expires_at",
        "policy",
        "authorization"
      ],
      "properties": {
        "decision_id": {"$ref": "common.schema.json#/$defs/uuid7"},
        "mission_id": {"type": "string", "minLength": 1},
        "action": {"enum": ["CONTINUE", "AVOID", "HOLD", "RETURN", "LAND", "ABORT"]},
        "priority": {"type": "integer", "minimum": 0, "maximum": 100},
        "path_id": {
          "oneOf": [
            {"$ref": "common.schema.json#/$defs/uuid7"},
            {"type": "null"}
          ]
        },
        "risk_id": {"$ref": "common.schema.json#/$defs/uuid7"},
        "twin_revision": {"type": "integer", "minimum": 0},
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
          "uniqueItems": true
        },
        "explanation": {"type": "string", "minLength": 1},
        "preconditions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "expires_at": {"type": "string", "format": "date-time"},
        "policy": {
          "type": "object",
          "required": ["name", "version", "ruleset_hash"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
            "ruleset_hash": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"}
          },
          "additionalProperties": false
        },
        "authorization": {
          "type": "object",
          "required": ["state", "gate", "checked_at", "failures"],
          "properties": {
            "state": {"enum": ["PENDING", "AUTHORIZED", "REJECTED"]},
            "gate": {"type": ["string", "null"]},
            "checked_at": {"type": ["string", "null"], "format": "date-time"},
            "failures": {
              "type": "array",
              "items": {"type": "string", "minLength": 1}
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
