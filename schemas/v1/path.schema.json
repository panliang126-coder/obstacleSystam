{
  "$id": "https://schemas.obstaclesystam.local/v1/path.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-wire-schema": "path/1.0",
  "title": "Path Message v1.0",
  "allOf": [
    {"$ref": "common.schema.json#/$defs/envelope"},
    {
      "properties": {
        "schema": {"const": "path/1.0"},
        "payload": {"$ref": "#/$defs/path_payload"}
      }
    }
  ],
  "$defs": {
    "path_payload": {
      "type": "object",
      "required": [
        "path_id",
        "mission_id",
        "planner",
        "twin_revision",
        "risk_id",
        "frame_id",
        "waypoints",
        "costs",
        "constraints_applied",
        "validation",
        "valid_until",
        "status"
      ],
      "properties": {
        "path_id": {"$ref": "common.schema.json#/$defs/uuid7"},
        "mission_id": {"type": "string", "minLength": 1},
        "planner": {
          "type": "object",
          "required": ["name", "version", "algorithm"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
            "algorithm": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "twin_revision": {"type": "integer", "minimum": 0},
        "risk_id": {"$ref": "common.schema.json#/$defs/uuid7"},
        "frame_id": {"type": "string", "minLength": 1},
        "waypoints": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["seq", "enu_m", "target_speed_m_s", "eta_s"],
            "properties": {
              "seq": {"type": "integer", "minimum": 0},
              "enu_m": {"$ref": "common.schema.json#/$defs/vector3"},
              "target_speed_m_s": {"type": "number", "minimum": 0},
              "eta_s": {"type": "number", "minimum": 0}
            },
            "additionalProperties": false
          }
        },
        "costs": {
          "type": "object",
          "required": ["distance", "time", "energy", "risk", "total"],
          "properties": {
            "distance": {"type": "number", "minimum": 0},
            "time": {"type": "number", "minimum": 0},
            "energy": {"type": "number", "minimum": 0},
            "risk": {"type": "number", "minimum": 0},
            "total": {"type": "number", "minimum": 0}
          },
          "additionalProperties": false
        },
        "constraints_applied": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "validation": {
          "type": "object",
          "required": ["collision_free", "dynamics_feasible", "geofence_valid", "minimum_clearance_m"],
          "properties": {
            "collision_free": {"type": "boolean"},
            "dynamics_feasible": {"type": "boolean"},
            "geofence_valid": {"type": "boolean"},
            "minimum_clearance_m": {"type": "number", "minimum": 0}
          },
          "additionalProperties": false
        },
        "valid_until": {"type": "string", "format": "date-time"},
        "status": {"enum": ["CANDIDATE", "SELECTED", "REJECTED", "EXPIRED"]}
      },
      "additionalProperties": false
    }
  }
}
