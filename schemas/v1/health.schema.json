{
  "$id": "https://schemas.obstaclesystam.local/v1/health.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-wire-schema": "health/1.0",
  "title": "Health Message v1.0",
  "allOf": [
    {"$ref": "common.schema.json#/$defs/envelope"},
    {
      "properties": {
        "schema": {"const": "health/1.0"},
        "payload": {"$ref": "#/$defs/health_payload"}
      }
    }
  ],
  "$defs": {
    "health_payload": {
      "type": "object",
      "required": [
        "component_id",
        "component_type",
        "status",
        "checked_at",
        "dependencies",
        "data_freshness_ms",
        "faults"
      ],
      "properties": {
        "component_id": {"type": "string", "minLength": 1},
        "component_type": {
          "enum": ["SENSOR", "SERVICE", "PLUGIN", "LINK", "STORAGE", "CONTROL_GATEWAY"]
        },
        "status": {"enum": ["HEALTHY", "DEGRADED", "UNHEALTHY", "STOPPED", "UNKNOWN"]},
        "checked_at": {"type": "string", "format": "date-time"},
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["component_id", "status"],
            "properties": {
              "component_id": {"type": "string", "minLength": 1},
              "status": {"enum": ["HEALTHY", "DEGRADED", "UNHEALTHY", "STOPPED", "UNKNOWN"]}
            },
            "additionalProperties": false
          }
        },
        "data_freshness_ms": {"type": ["number", "null"], "minimum": 0},
        "faults": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "message", "retryable"],
            "properties": {
              "code": {"type": "string", "minLength": 1},
              "message": {"type": "string", "minLength": 1},
              "retryable": {"type": "boolean"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
